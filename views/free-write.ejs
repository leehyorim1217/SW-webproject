<!--자유게시판  및 공지사항 글 작성 코드-->
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>글 작성</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.snow.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h4 class="card-title mb-0">새 글 작성</h4>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" action="/write/free" enctype="multipart/form-data" id="freeWriteForm">
                            <!-- 게시판 선택 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>게시판 선택:</strong></div>
                                    <div class="col-sm-9">
                                        <select class="form-select" name="boardType" required>
                                            <option value="free" <%= (!boardType || boardType === 'free') ? 'selected' : '' %>>자유게시판</option>
                                            <option value="notice" <%= boardType === 'notice' ? 'selected' : '' %>>공지사항</option>
                                        </select>
                                    </div>
                                </div>
                                <hr>
                            </div>
                            
                            <!-- 제목 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>제목:</strong></div>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" name="title" placeholder="제목" required>
                                    </div>
                                </div>
                                <hr>
                            </div>
                            
                            <!-- 내용 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>내용:</strong></div>
                                    <div class="col-sm-9">
                                        <div class="border" style="min-height: 350px;">
                                            <div id="editor" style="height: 300px;"></div>
                                        </div>
                                        <textarea name="content" id="content" style="display: none;"></textarea>
                                    </div>
                                </div>
                                <hr>
                            </div>

                            <!-- 이미지 업로드 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>이미지 첨부:</strong></div>
                                    <div class="col-sm-9">
                                        <input type="file" class="form-control" name="image" accept="image/*">
                                        <small class="text-muted">JPG, PNG, GIF 파일만 업로드 가능합니다</small>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- 버튼 그룹 -->
                            <div class="d-flex justify-content-between pt-3 border-top">
                                <button type="button" class="btn btn-secondary" onclick="goBack()">게시판으로 돌아가기</button>
                                <button type="submit" class="btn btn-primary">작성 완료</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.min.js"></script>

    <script>
    const quill = new Quill('#editor', {
        theme: 'snow',
        modules: {
            toolbar: [
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'header': [1, 2, 3, false] }],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'align': [] }],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                [{ 'indent': '-1'}, { 'indent': '+1' }],
                ['link'],
                ['clean']
            ]
        },
        placeholder: '내용을 입력하세요...'
    });

    const boardTypeSelect = document.querySelector('select[name="boardType"]');

    document.getElementById('freeWriteForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // 제목 체크
        const title = document.querySelector('input[name="title"]').value.trim();
        if (!title) {
            alert('제목을 입력해주세요.');
            return;
        }

        // 내용 체크
        const textContent = quill.getText().trim();
        if (textContent.length === 0) {
            alert('내용을 입력해주세요.');
            return;
        }

        // Quill 에디터 내용을 hidden textarea에 저장
        document.getElementById('content').value = quill.root.innerHTML;
        
        // 기본 폼 제출
        this.submit();
    });

    function goBack() {
        const boardType = boardTypeSelect.value;
        window.location.href = `/?board=${boardType}`;
    }
    </script>

    <style>
    .ql-editor {
        min-height: 250px;
        font-size: 14px;
        line-height: 1.6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .ql-toolbar, .ql-container, .card, .form-control, .form-select, .btn, .border, .bg-light {
        border-radius: 0 !important;
    }

    .ql-toolbar {
        border-top: 1px solid #dee2e6;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }

    .ql-container {
        border-bottom: 1px solid #dee2e6;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
    }

    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
    
    *, *::before, *::after {
        border-radius: 0 !important;
    }
    </style>
</body>
</html>