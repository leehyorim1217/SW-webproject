<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      
      <!-- 게시글 내용 -->
      <div class="card border shadow-sm mb-4">
        <div class="card-header bg-light text-dark border-bottom">
          <h4 class="card-title mb-0 text-dark"><%= post.title %></h4>
          <small class="text-muted">
            작성자: <%= post.username %> | 작성일: <%= post.createdAt %>
          </small>
        </div>
        <div class="card-body p-3">
          <div class="mb-3">
            <div class="row mb-2">
              <div class="col-sm-9">
                <div class="post-content">
                  <%- post.content %>
                  <% if (post.image) { %>
                    <div class="mt-3">
                      <img src="/uploads/<%= post.image %>" alt="첨부 이미지" class="img-fluid border">
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
            <% if (post.auctionInfo) { %><hr><% } %>
          </div>

          <!-- 아이템 정보 섹션 -->
          <% if (post.auctionInfo) { %>
            <div class="mb-3">
              <div class="row mb-2">
                <div class="col-sm-9">
                  <div class="bg-light p-2">
                    <div id="item-info-display">
                      <% 
                      let itemData = null;
                      if (post.auctionInfo) {
                        if (typeof post.auctionInfo === 'string') {
                          if (post.auctionInfo.trim().startsWith('{') || post.auctionInfo.trim().startsWith('[')) {
                            itemData = post.auctionInfo;
                          }
                        } else {
                          itemData = post.auctionInfo;
                        }
                      }
                      
                      if (itemData) {
                        let parsedItem = null;
                        if (typeof itemData === 'string') {
                          const jsonStr = itemData.trim();
                          if (jsonStr.startsWith('{') && jsonStr.endsWith('}')) {
                            parsedItem = itemData;
                          }
                        } else {
                          parsedItem = itemData;
                        }
                        
                        if (parsedItem) {
                      %>
                          <div class="item-info-container">
                            <% if (typeof parsedItem === 'object') { %>
                              <div class="row">
                                <div class="col-12">
                                  <h5 class="text-dark mb-2"><%= parsedItem.item_name || parsedItem.item_display_name || '아이템 정보' %></h5>
                                  <% if (parsedItem.item_count) { %>
                                    <p class="mb-1"><strong>개수:</strong> <%= parsedItem.item_count %>개</p>
                                  <% } %>
                                  <% if (parsedItem.auction_price_per_unit) { %>
                                    <p class="mb-1 text-dark"><strong>가격:</strong> <%= parsedItem.auction_price_per_unit.toLocaleString() %> G</p>
                                  <% } %>
                                  <% if (parsedItem.auction_item_category) { %>
                                    <p class="mb-1"><strong>카테고리:</strong> <%= parsedItem.auction_item_category %></p>
                                  <% } %>
                                  <% if (parsedItem.date_auction_expire) { %>
                                    <p class="mb-1"><strong>만료:</strong> <%= new Date(parsedItem.date_auction_expire).toLocaleString() %></p>
                                  <% } %>
                                  
                                  <% if (parsedItem.item_option && Array.isArray(parsedItem.item_option) && parsedItem.item_option.length > 0) { %>
                                    <div class="mt-3">
                                      <h6 class="text-secondary mb-2">아이템 옵션</h6>
                                      <ul class="list-unstyled">
                                        <% parsedItem.item_option.forEach(function(opt) { %>
                                          <% if (opt.option_type && opt.option_value) { %>
                                            <li>
                                              <strong><%= opt.option_type %>:</strong> 
                                              <%= opt.option_value %><% if (opt.option_value2) { %>~<%= opt.option_value2 %><% } %>
                                              <% if (opt.option_sub_type) { %> (<%= opt.option_sub_type %>)<% } %>
                                            </li>
                                          <% } %>
                                        <% }); %>
                                      </ul>
                                    </div>
                                  <% } %>
                                </div>
                              </div>
                            <% } else { %>
                              <div id="client-item-data" style="display: none;"><%= parsedItem %></div>
                              <p class="text-info">아이템 정보를 로딩 중...</p>
                            <% } %>
                          </div>
                      <% } else { %>
                          <p class="text-warning">아이템 정보를 처리할 수 없습니다.</p>
                      <% } %>
                      <% } else { %>
                        <p class="text-muted">아이템 정보가 없습니다.</p>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <% if (post.userId === session.userId) { %>
            <div class="d-flex justify-content-end gap-2 pt-2">
              <a href="/edit/<%= post.id %>" class="btn btn-outline-dark btn-sm">수정</a>
              <form method="post" action="/delete/<%= post.id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-outline-danger btn-sm" onclick="return confirm('정말 삭제하시겠습니까?')">삭제</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>

      <!-- 댓글 섹션 -->
      <div class="card border shadow-sm">
        <div class="card-header bg-light text-dark border-bottom">
          <h5 class="card-title mb-0 text-dark">
            댓글 <span class="badge bg-warning text-dark ms-2">
              <%= comments.reduce((total, comment) => total + 1 + comment.replies.length, 0) %>
            </span>
          </h5>
        </div>
        <div class="card-body p-3">
          
          <div class="mb-3">
            <div class="row mb-2">
              <div class="col-sm-3"><strong>댓글 :</strong></div>
              <div class="col-sm-9">
                <form method="post" action="/post/<%= post.id %>/comment">
                  <textarea class="form-control mb-2" name="content" rows="2" placeholder="댓글을 입력하세요..." required style="resize: none;"></textarea>
                  <input type="hidden" name="parent_id" value="">
                  <button type="submit" class="btn btn-warning btn-sm">댓글</button>
                </form>
              </div>
            </div>
            <hr>
          </div>

          <div class="row mb-2">
            <div class="col-sm-3"><strong>댓글 목록 :</strong></div>
            <div class="col-sm-9">
            <div id="commentsList">
                <% if (comments.length > 0) { %>
                  <% comments.forEach(comment => { %>
                    <%- renderComment(comment, 0, post.id, session.username || '') %>
                  <% }) %>
                <% } else { %>
                  <div class="text-center py-3 text-muted bg-light">
                    <p class="mb-0">첫 번째 댓글을 작성해보세요.</p>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-3">
        <a href="/" class="btn btn-outline-dark btn-sm">게시판으로 돌아가기</a>
      </div>
    </div>
  </div>
</div>

<%
function renderComment(comment, depth, postId, currentUsername) {
  const maxDepth = 2;
  const indentClass = depth > 0 ? `ms-${Math.min(depth * 3, 9)}` : '';
  const bgClass = depth > 0 ? 'bg-light' : 'bg-white';
  
  let html = `
    <div class="comment-item mb-3 ${indentClass}" data-comment-id="${comment.id}">
      <div class="border ${bgClass} p-3" style="border-left: 4px solid #007bff;">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <strong class="text-dark" style="font-size: 15px;">${comment.username}</strong>
            <small class="text-muted ms-2">${comment.createdAt}</small>
            ${depth > 0 ? '<span class="badge bg-secondary ms-2">답글</span>' : ''}
            
            <!--댓글 수정-->
          </div>
          ${comment.username === currentUsername ? `
            <div class="btn-group" role="group">
              <a href="/comment/${comment.id}/edit" class="btn btn-outline-secondary btn-sm">수정</a>
              <button class="btn btn-outline-danger btn-sm" onclick="deleteComment(${comment.id})">삭제</button>
            </div>
          ` : ''}
        </div>
        
        <div class="comment-content mb-2" style="font-size: 14px; line-height: 1.6; padding: 8px 0;">${comment.content}</div>
        
        ${depth < maxDepth ? `
          <div class="border-top pt-2 mt-2">
            <button class="btn btn-outline-warning btn-sm" onclick="toggleReplyForm(${comment.id})">
              <i class="bi bi-reply"></i> 답글
            </button>
          </div>
          
          <div class="reply-form mt-3 bg-white p-3 border" id="replyForm${comment.id}" style="display: none;">
            <form method="post" action="/post/${postId}/comment">
              <div class="mb-3">
                <textarea class="form-control" name="content" rows="3" 
                         placeholder="${comment.username}님에게 답글..." required style="resize: none; font-size: 14px;"></textarea>
                <input type="hidden" name="parent_id" value="${comment.id}">
              </div>
              <div class="text-end">
                <button type="submit" class="btn btn-warning btn-sm">답글 작성</button>
                <button type="button" class="btn btn-secondary btn-sm ms-2" onclick="toggleReplyForm(${comment.id})">취소</button>
              </div>
            </form>
          </div>
        ` : ''}
      </div>
    </div>
  `;
  
  if (comment.replies && comment.replies.length > 0) {
    comment.replies.forEach(reply => {
      html += renderComment(reply, depth + 1, postId, currentUsername);
    });
  }
  
  return html;
}
%>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const clientData = document.getElementById('client-item-data');
  if (clientData) {
    const jsonString = clientData.textContent.trim();
    if (jsonString && jsonString.length > 0) {
      let itemData = parseJsonString(jsonString);
      
      if (!itemData) {
        const firstParse = parseJsonString(jsonString);
        if (firstParse && typeof firstParse === 'string') {
          itemData = parseJsonString(firstParse);
        }
      }
      
      if (itemData && typeof itemData === 'object') {
        displayParsedItemInfo(itemData, clientData.parentElement);
      } else {
        clientData.parentElement.innerHTML = '<p class="text-warning">아이템 정보 형식이 올바르지 않습니다.</p>';
      }
    }
  }
});

const parseJsonString = (str) => {
  if (!str || typeof str !== 'string') return null;
  
  const trimmed = str.trim();
  if (!trimmed.startsWith('{') || !trimmed.endsWith('}')) return null;
  
  try {
    return (new Function('return ' + trimmed))();
  } catch {
    return null;
  }
};

const displayParsedItemInfo = (item, container) => {
  const importantOptions = [];
  const colorOptions = [];
  const enchantOptions = [];
  
  if (item.item_option && Array.isArray(item.item_option)) {
    item.item_option.forEach(opt => {
      if (!opt.option_type || !opt.option_value) return;
      
      const optionType = opt.option_type.toLowerCase();
      if (optionType.includes('색상') || optionType.includes('color')) {
        colorOptions.push(opt);
      } else if (optionType.includes('인챈트') || optionType.includes('enchant')) {
        enchantOptions.push(opt);
      } else if (!['아이템 보호', '내구력', '수리비'].includes(optionType)) {
        importantOptions.push(opt);
      }
    });
  }
  
  let html = `<div class="row"><div class="col-md-8"><div class="mb-3">
    <div class="d-flex align-items-center mb-2">
      <h5 class="text-dark mb-0 me-3">${item.item_name || item.item_display_name || '알 수 없는 아이템'}</h5>
    </div>
    <div class="row">
      <div class="col-6">
        <p class="mb-1"><strong>개수:</strong> ${item.item_count || 1}개</p>
        <p class="mb-1"><strong>카테고리:</strong> ${item.auction_item_category || '미분류'}</p>
      </div>
      <div class="col-6">
        <p class="mb-1 text-dark"><strong>가격:</strong> ${(item.auction_price_per_unit || 0).toLocaleString()} G</p>
        <p class="mb-1"><strong>만료:</strong> ${item.date_auction_expire ? new Date(item.date_auction_expire).toLocaleString() : '정보 없음'}</p>
      </div>
    </div></div>`;
  
  if (importantOptions.length > 0) {
    html += '<div class="mb-3"><h6 class="text-secondary mb-2">주요 옵션</h6><ul class="list-unstyled">';
    importantOptions.forEach(opt => {
      const value = opt.option_value2 ? `${opt.option_value}~${opt.option_value2}` : opt.option_value;
      html += `<li><strong>${opt.option_type}:</strong> ${value}</li>`;
    });
    html += '</ul></div>';
  }
  
  if (enchantOptions.length > 0) {
    html += '<div class="mb-3"><h6 class="text-secondary mb-2">인챈트</h6><ul class="list-unstyled">';
    enchantOptions.forEach(opt => {
      html += `<li><strong>${opt.option_sub_type || opt.option_type}:</strong> ${opt.option_value}</li>`;
      if (opt.option_desc) {
        html += `<li><small class="text-muted">${opt.option_desc}</small></li>`;
      }
    });
    html += '</ul></div>';
  }
  
  html += '</div>';
  
  if (colorOptions.length > 0) {
    html += '<div class="col-md-4"><h6 class="text-secondary mb-2">색상 상세</h6>';
    colorOptions.forEach(opt => {
      const colorInfo = getColorInfo(opt.option_value);
      if (colorInfo) {
        html += `<div class="mb-3 p-2 border">
          <small class="d-block text-muted mb-1">${opt.option_sub_type || '색상'}</small>
          <div class="d-flex align-items-center mb-2">
            <div style="width: 40px; height: 40px; background-color: ${colorInfo.css}; border: 2px solid #333; margin-right: 10px;"></div>
            <div>
              <div class="small"><strong>${colorInfo.display}</strong></div>
              <div class="text-muted" style="font-size: 0.8em;">${colorInfo.css}</div>
            </div>
          </div>
        </div>`;
      } else {
        html += `<p class="mb-2"><strong>${opt.option_sub_type || '색상'}:</strong> ${opt.option_value}</p>`;
      }
    });
    html += '</div>';
  }
  
  html += '</div>';
  container.innerHTML = html;
};

const getColorInfo = (colorValue) => {
  if (!colorValue) return null;
  
  // RGB 형식
  if (typeof colorValue === 'string' && colorValue.includes(',')) {
    const parts = colorValue.split(',');
    if (parts.length >= 3) {
      const r = parseInt(parts[0].trim());
      const g = parseInt(parts[1].trim());
      const b = parseInt(parts[2].trim());
      
      if (!isNaN(r) && !isNaN(g) && !isNaN(b) && r >= 0 && r <= 255 && g >= 0 && g <= 255 && b >= 0 && b <= 255) {
        return {
          css: `rgb(${r}, ${g}, ${b})`,
          display: `RGB(${r}, ${g}, ${b})`
        };
      }
    }
  }
  
  // 16진수 형식
  if (typeof colorValue === 'string') {
    const hexPattern = /^#?([A-Fa-f0-9]{6})$/;
    const match = colorValue.match(hexPattern);
    if (match) {
      return {
        css: '#' + match[1],
        display: '#' + match[1].toUpperCase()
      };
    }
  }
  
  // 색상 이름
  if (typeof colorValue === 'string' && !colorValue.includes(',') && isNaN(parseInt(colorValue))) {
    return {
      css: colorValue,
      display: colorValue
    };
  }
  
  return null;
};

const toggleReplyForm = (commentId) => {
  const replyForm = document.getElementById('replyForm' + commentId);
  if (replyForm.style.display === 'none') {
    replyForm.style.display = 'block';
    replyForm.querySelector('textarea').focus();
  } else {
    replyForm.style.display = 'none';
  }
};

const deleteComment = (commentId) => {
  if (confirm('이 댓글을 삭제하시겠습니까?')) {
    fetch('/comment/' + commentId, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert(data.message || '삭제에 실패했습니다.');
      }
    })
    .catch(() => alert('오류가 발생했습니다.'));
  }
};
</script>

<style>
