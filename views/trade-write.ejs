<!--거래게시판 글 작성 코드-->
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>글쓰기</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.snow.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h4 class="card-title mb-0">새 글 작성</h4>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" action="/write/trade" enctype="multipart/form-data" id="tradeWriteForm">
                            <input type="hidden" name="boardType" value="general">
                            
                            <!-- 제목 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>제목:</strong></div>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" name="title" placeholder="제목" required>
                                    </div>
                                </div>
                                <hr>
                            </div>
                            
                            <!-- 아이템 검색 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3">
                                        <strong>아이템 검색: <span class="text-danger">*</span></strong>
                                        <small class="text-muted d-block">필수 항목</small>
                                    </div>
                                    <div class="col-sm-9">
                                        <div class="bg-light p-3">
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="item_name" 
                                                           placeholder="아이템명 입력 (예: 나이트브링어 프레데터)" style="height: 38px;">
                                                </div>
                                                <div class="col-md-4">
                                                    <button type="button" class="btn btn-outline-primary w-100" 
                                                            onclick="searchItem()" style="height: 38px;">검색</button>
                                                </div>
                                            </div>
                                            
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                                        id="loadMoreBtn" style="display:none;" onclick="loadMore()">더 보기</button>
                                            </div>
                                            
                                            <div id="auction-result" class="border p-3 bg-white" 
                                                 style="max-height: 250px; overflow-y: auto; min-height: 60px;">
                                                <div class="text-center text-muted">
                                                    <p class="mb-0">아이템명을 입력하고 검색 버튼을 클릭하세요</p>
                                                </div>
                                            </div>
                                            
                                            <!-- 선택된 아이템 표시하는 부분 -->
                                            <div id="selectedItemArea" class="mt-3" style="display: none;">
                                                <div class="alert alert-info mb-0">
                                                    <strong>선택된 아이템:</strong>
                                                    <div id="selectedItemInfo"></div>
                                                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" onclick="clearSelectedItem()">선택 해제</button>
                                                </div>
                                            </div>
                                            
                                            <input type="hidden" name="auctionInfo" id="auctionInfo">
                                        </div>
                                    </div>
                                </div>
                                <hr>
                            </div>
                            
                            <!-- 내용 섹션 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>내용:</strong></div>
                                    <div class="col-sm-9">
                                        <div class="border" style="min-height: 350px;">
                                            <div id="editor" style="height: 300px;"></div>
                                        </div>
                                        <textarea name="content" id="content" style="display: none;"></textarea>
                                    </div>
                                </div>
                                <hr>
                            </div>

                            <!-- 이미지 업로드 섹션 -->
                            <div class="mb-4">
                                <div class="row mb-2">
                                    <div class="col-sm-3"><strong>이미지 첨부:</strong></div>
                                    <div class="col-sm-9">
                                        <input type="file" class="form-control" name="image" accept="image/*">
                                        <small class="text-muted">JPG, PNG, GIF 파일만 업로드 가능합니다</small>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- 버튼 -->
                            <div class="d-flex justify-content-between pt-3 border-top">
                                <a href="/?board=general" class="btn btn-secondary">게시판으로 돌아가기</a>
                                <button type="submit" class="btn btn-primary">글 작성</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.min.js"></script>

    <script>
    const quill = new Quill('#editor', {
        theme: 'snow',
        modules: {
            toolbar: [
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'header': [1, 2, 3, false] }],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'align': [] }],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                [{ 'indent': '-1'}, { 'indent': '+1' }],
                ['link'],
                ['clean']
            ]
        },
        placeholder: '내용을 입력하세요...'
    });

    document.getElementById('tradeWriteForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // 01 제목 있음?
        const title = document.querySelector('input[name="title"]').value.trim();
        if (!title) {
            alert('제목을 입력해주세요.');
            return;
        }

        //02 내용 있음?
        const textContent = quill.getText().trim();
        if (textContent.length === 0) {
            alert('내용을 입력해주세요.');
            return;
        }

        //게시글 조건 확인 03 거래 아이템 포함?
        const auctionInfo = document.getElementById('auctionInfo').value;
        if (!auctionInfo) {
            alert('거래할 아이템을 검색하고 선택해주세요.');
            return;
        }

        // 이거 없으면 html 태그 붙어서 나옴
        document.getElementById('content').value = quill.root.innerHTML;
        
        // 기본 폼 제출
        this.submit();
    });

    let nextCursor = null;

    const searchItem = async (cursor = '') => {
        const itemName = document.getElementById('item_name').value.trim();
        if (!itemName) {
            alert('아이템명을 입력해주세요.');
            return;
        }

        const resultEl = document.getElementById('auction-result');
        
        if (!cursor) {
            resultEl.innerHTML = 
                '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">검색 중...</span></div><p class="mt-2 mb-0">검색 중입니다...</p></div>';
        }

        try {
            const url = `/api/mabi-auction?keyword=${encodeURIComponent(itemName)}${cursor ? '&cursor=' + cursor : ''}`;
            const res = await fetch(url);
            const data = await res.json();

            if (data.auction_item && data.auction_item.length > 0) {
                if (!cursor) resultEl.innerHTML = '';

                data.auction_item.forEach(item => {
                    const itemEl = createItemElement(item);
                    resultEl.appendChild(itemEl);
                });

                nextCursor = data.next_cursor || null;
                document.getElementById('loadMoreBtn').style.display = nextCursor ? 'inline-block' : 'none';

            } else {
                if (!cursor) {
                    resultEl.innerHTML = 
                        '<div class="text-center text-muted"><p class="mb-0">검색 결과가 없습니다</p><small>다른 키워드로 검색해보세요</small></div>';
                    document.getElementById('loadMoreBtn').style.display = 'none';
                }
            }
        } catch (err) {
            resultEl.innerHTML = 
                '<div class="text-center text-danger"><p class="mb-0">검색 중 오류가 발생했습니다</p><small>잠시 후 다시 시도해주세요</small></div>';
            document.getElementById('loadMoreBtn').style.display = 'none';
        }
    };

    const createItemElement = (item) => {
        const div = document.createElement('div');
        div.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
        div.style.cursor = 'pointer';

        const options = item.item_option?.length > 0
            ? item.item_option.map(opt => `${opt.option_type}: ${opt.option_value}`).join(', ')
            : '옵션 없음';

        div.innerHTML = `
            <div>
                <strong>${item.item_name}</strong> (${item.item_count}개)
                <br>
                <span class="text-success">단가: ${item.auction_price_per_unit.toLocaleString()} G</span>
                <br>
                <small class="text-muted">만료: ${new Date(item.date_auction_expire).toLocaleString()}</small>
                <br>
                <small class="text-muted">옵션: ${options}</small>
            </div>
        `;

        div.addEventListener('click', () => selectItem(item));
        return div;
    };

    const selectItem = (item) => {
        const options = item.item_option?.length > 0
            ? item.item_option.map(opt => `${opt.option_type}: ${opt.option_value}`).join(', ')
            : '옵션 없음';

        document.getElementById('selectedItemInfo').innerHTML = `
            <div class="mt-2">
                <strong>${item.item_name}</strong> (${item.item_count}개)<br>
                <span class="text-success">단가: ${item.auction_price_per_unit.toLocaleString()} G</span><br>
                <small class="text-muted">만료: ${new Date(item.date_auction_expire).toLocaleString()}</small><br>
                <small class="text-muted">옵션: ${options}</small>
            </div>
        `;

        document.getElementById('selectedItemArea').style.display = 'block';
        document.getElementById('auctionInfo').value = JSON.stringify(item);
    };

    const clearSelectedItem = () => {
        document.getElementById('selectedItemArea').style.display = 'none';
        document.getElementById('selectedItemInfo').innerHTML = '';
        document.getElementById('auctionInfo').value = '';
    };

    const loadMore = () => {
        if (nextCursor) searchItem(nextCursor);
    };
    </script>

    <style>
    .ql-editor {
        min-height: 250px;
        font-size: 14px;
        line-height: 1.6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .ql-toolbar, .ql-container, .card, .form-control, .form-select, .btn, .border, .bg-light, .list-group-item {
        border-radius: 0 !important;
    }

    .ql-toolbar {
        border-top: 1px solid #dee2e6;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }

    .ql-container {
        border-bottom: 1px solid #dee2e6;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
    }

    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }

    #auction-result::-webkit-scrollbar {
        width: 8px;
    }

    #auction-result::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    #auction-result::-webkit-scrollbar-thumb {
        background: #c1c1c1;
    }
    
    *, *::before, *::after {
        border-radius: 0 !important;
    }
    </style>
</body>
</html>