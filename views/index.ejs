<div class="container mt-4">
  <!-- 게시판 제목 -->
  <% 
    let boardTitle = '자유 게시판';
    if (boardType === 'deal') boardTitle = '거래 게시판';
    else if (boardType === 'notice') boardTitle = '공지사항';
  %>
  <h2><%= boardTitle %></h2>
  
  <!-- 게시판 탭 -->
  <ul class="nav nav-tabs mb-3">
    <li class="nav-item">
      <a class="nav-link <%= (!boardType || boardType === 'free') ? 'active' : '' %>" href="/?board=free">자유 게시판</a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= boardType === 'deal' ? 'active' : '' %>" href="/?board=deal">거래 게시판</a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= boardType === 'notice' ? 'active' : '' %>" href="/?board=notice">공지사항</a>
    </li>
  </ul>
  
  <table class="table table-bordered">
    <thead>
      <tr>
        <th width="60%">제목</th>
        <th width="20%">작성자</th>
        <th width="20%">작성일</th>
      </tr>
    </thead>
    <tbody>
      <!--공지사항은 모든 게시판 최상단에 표시-->
      <% if (latestNotice && boardType !== 'notice') { %>
        <tr class="table-warning">
          <td>
            <div class="d-flex align-items-center">

              <!-- 썸네일 이미지 -->
              <div class="me-3 flex-shrink-0">
                <% if (latestNotice.image) { %>
                  <img src="/uploads/<%= latestNotice.image %>" 
                       alt="썸네일" 
                       style="width: 50px; height: 50px; object-fit: cover;">
                <% } else { %>
                  <!-- 부트스트랩 아이콘 사용해서 이미지 없으면 기본 아이콘 나오게 -->
                  <div class="bg-light border d-flex align-items-center justify-content-center"
                       style="width: 50px; height: 50px;">
                    <svg width="24" height="24" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                      <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                      <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                    </svg>
                  </div>
                <% } %>
              </div>
              
              <!-- 제목 -->
              <div class="flex-grow-1">
                <a href="/post/<%= latestNotice.id %>" class="text-decoration-none text-dark">
                  <%= latestNotice.title %>
                </a>
                <span class="badge bg-danger ms-2">공지</span>
              </div>
            </div>
          </td>
          <td class="align-middle">
            <%= latestNotice.username %>
          </td>
          <td class="align-middle">
            <%= latestNotice.createdAt %>
          </td>
        </tr>
      <% } %>
      
      <!--일반 게시글 목록-->
      <% if (posts && posts.length > 0) { %>
        <% posts.forEach(post => { %>
        <tr>
          <td>
            <div class="d-flex align-items-center">
              <!-- 썸네일 이미지 -->
              <div class="me-3 flex-shrink-0">
                <% if (post.image) { %>
                  <img src="/uploads/<%= post.image %>" 
                       alt="썸네일" 
                       style="width: 50px; height: 50px; object-fit: cover;">
                <% } else { %>
                  <!-- 부트스트랩 아이콘 사용해서 이미지 없으면 기본 아이콘 나오게 -->
                  <div class="bg-light border d-flex align-items-center justify-content-center"
                       style="width: 50px; height: 50px;">
                    <svg width="24" height="24" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                      <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                      <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                    </svg>
                  </div>
                <% } %>
              </div>
              
              <!-- 제목 -->
              <div class="flex-grow-1">
                <a href="/post/<%= post.id %>" class="text-decoration-none text-dark">
                  <%= post.title %>
                </a>
                <% if (post.boardType === 'notice') { %>
                  <span class="badge bg-danger ms-2">공지</span>
                <% } %>
              </div>
            </div>
          </td>
          <td class="align-middle">
            <%= post.username %>
          </td>
          <td class="align-middle">
            <%= post.createdAt %>
          </td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="3" class="text-center py-4 text-muted">
            <% if (query) { %>
              "<%= query %>"에 대한 검색 결과가 없습니다.
            <% } else { %>
              등록된 게시글이 없습니다.
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <!-- 검색창 / 글쓰기 버튼 -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <form method="get" style="width: 400px;">
      <input type="hidden" name="board" value="<%= boardType || 'free' %>">
      <div class="input-group">
        <input type="text" class="form-control" name="q" value="<%= query || '' %>" placeholder="검색" style="border-radius: 0;">
        <button class="btn btn-outline-secondary" style="border-radius: 0;">검색</button>
      </div>
    </form>
    
    <% if (boardType === 'deal') { %>
      <a href="/write/trade" class="btn btn-primary">글쓰기</a>
    <% } else { %>
      <a href="/write/free?board=<%= boardType %>" class="btn btn-primary">글쓰기</a>
    <% } %>
  </div>

  <!-- 페이지네이션 -->
  <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
    <div class="d-flex justify-content-center mt-4">
      <nav aria-label="페이지 네비게이션">
        <ul class="pagination">
          
          <!-- 이전 그룹 -->
          <% if (pagination.startPage > 1) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= pagination.startPage - 1 %><%= boardType ? '&board=' + boardType : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
                &laquo;
              </a>
            </li>
          <% } %>
          
          <!-- 이전 페이지 -->
          <% if (pagination.hasPrevPage) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= pagination.prevPage %><%= boardType ? '&board=' + boardType : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
                이전
              </a>
            </li>
          <% } %>
          
          <!-- 페이지 번호 -->
          <% for (let i = pagination.startPage; i <= pagination.endPage; i++) { %>
            <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= i %><%= boardType ? '&board=' + boardType : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
                <%= i %>
              </a>
            </li>
          <% } %>
          
          <!-- 다음 페이지 -->
          <% if (pagination.hasNextPage) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= pagination.nextPage %><%= boardType ? '&board=' + boardType : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
                다음
              </a>
            </li>
          <% } %>
          
          <!-- 다음 그룹 -->
          <% if (pagination.endPage < pagination.totalPages) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= pagination.endPage + 1 %><%= boardType ? '&board=' + boardType : '' %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
                &raquo;
              </a>
            </li>
          <% } %>
          
        </ul>
      </nav>
    </div>
  <% } %>
</div>