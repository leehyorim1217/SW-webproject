<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card border-0 shadow-sm mt-5">
        <div class="card-body p-4">
          
          <h4 class="card-title text-center mb-4 fw-normal">로그인</h4>
          
          <form method="post" action="/login">
            <div class="mb-3">
              <label class="form-label">아이디</label>
              <input type="text" class="form-control" name="username" 
                     value="<%= typeof username !== 'undefined' ? username : '' %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">비밀번호</label>
              <input type="password" class="form-control" name="password" required>
            </div>
            <button type="submit" class="btn btn-dark w-100">로그인</button>
          </form>

          <!-- 로그인 실패 -->
          <% if (typeof loginError !== 'undefined' && loginError) { %>
            <div class="alert alert-danger mt-3">
              <%= loginError %>
              <div class="mt-2">
                <a href="/register" class="btn btn-link p-0 text-decoration-none">회원가입으로 이동하기</a>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 회원가입 성공시 유저 이름 보여줌 (바로 가져오면 보안상 문제 있으니 한번 걸러서) -->
<% if (typeof showPopup !== 'undefined' && showPopup) { %>
  <div class="position-fixed top-50 start-50 translate-middle bg-light border p-4 shadow" 
       style="z-index: 9999;" id="popup">
    <div class="text-success fw-semibold">
      회원가입 성공. <%= welcomeUser %>님 환영합니다.
    </div>
  </div>

  <script>
    setTimeout(() => {
      const popup = document.getElementById('popup');
      if (popup) {
        popup.style.display = 'none';
      }
    }, 3000);
  </script>
<% } %>