<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      
      <!-- 댓글 수정 -->
      <div class="card border shadow-sm">
        <div class="card-header bg-light text-dark border-bottom">
          <h4 class="card-title mb-0 text-dark">댓글 수정</h4>
          <small class="text-muted">
            원본 게시글: <%= post.title %> | 작성자: <%= comment.username %>
          </small>
        </div>
        <div class="card-body p-3">
          
          <form method="post" action="/comment/<%= comment.id %>?_method=PUT">
            <div class="mb-3">
              <div class="row mb-2">
                <div class="col-sm-3"><strong>댓글 내용:</strong></div>
                <div class="col-sm-9">
                  <textarea name="content" class="form-control" rows="4" 
                           placeholder="댓글 내용을 입력하세요..." 
                           required style="resize: none;"><%= comment.content %></textarea>
                </div>
              </div>
            </div>
            
            <hr>
            
            <div class="d-flex justify-content-between">
              <a href="/post/<%= post.id %>" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-left"></i> 취소
              </a>
              <button type="submit" class="btn btn-warning btn-sm">
                <i class="bi bi-check-lg"></i> 수정 완료
              </button>
            </div>
          </form>
          
        </div>
      </div>
      
    </div>
  </div>
</div>

<style>
.card, .card-header, .card-body, .form-control, .btn, .border, .bg-light {
    border-radius: 0 !important;
}

.card-header.bg-light {
    background-color: #f8f9fa !important;
    border-bottom: 2px solid #dee2e6 !important;
}

.form-control {
    border: 1px solid #ced4da;
    background-color: #ffffff;
}

.form-control:focus {
    border-color: #495057;
    box-shadow: 0 0 0 0.2rem rgba(73, 80, 87, 0.15);
    background-color: #ffffff;
}

.btn-warning {
    background-color: #ffc107;
    border-color: #ffc107;
    color: #000000;
    font-weight: 500;
}

.btn-warning:hover {
    background-color: #e0a800;
    border-color: #d39e00;
    color: #000000;
}

.btn-outline-dark {
    color: #343a40;
    border-color: #343a40;
}

.btn-outline-dark:hover {
    background-color: #343a40;
    border-color: #343a40;
    color: #ffffff;
}

.text-dark {
    color: #212529 !important;
}

.text-muted {
    color: #6c757d !important;
}

.shadow-sm {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
}

.btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}

.form-text {
    font-size: 0.875em;
}
</style>